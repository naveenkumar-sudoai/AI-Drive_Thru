# AI Drive-Thru backend + dashboard (systemd unit for headless/enclosure use).
#
# Install:
#   sudo cp systemd/ai-drive-thru-backend.service /etc/systemd/system/
#   # EDIT User=, WorkingDirectory= and ExecStart= to match your Pi user + clone path
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-drive-thru-backend
#
# View logs:  journalctl -u ai-drive-thru-backend -f

[Unit]
Description=AI Drive-Thru backend + dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ai_drive_thru
ExecStart=/home/pi/ai_drive_thru/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
